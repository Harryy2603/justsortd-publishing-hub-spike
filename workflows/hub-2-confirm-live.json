    {
      "parameters": {
        "jsCode": "// Hub 2 - ask Buffer which posts have actually been sent (one call covers every post)\nconst cfg = $('Config').first().json;\nconst pages = ($input.first().json.results) || [];\nif (!pages.length) return [];\nconst query = 'query { posts(first: 50, input: { organizationId: \"' + cfg.bufferOrgId + '\", filter: { status: [sent], channelIds: [\"' + cfg.xChannelId + '\", \"' + cfg.blueskyChannelId + '\"] }, sort: [{ field: dueAt, direction: desc }] }) { edges { node { id channelId dueAt externalLink } } } }';\nreturn [{ json: { query } }];\n"
      },
      "id": "01874757-01ee-4473-967d-adf8bb2440b8",
      "name": "Ask Buffer what was sent",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.buffer.com",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ query: $json.query }) }}",
        "options": {}
      },
      "id": "e1dbb0db-a4bd-4c4d-9aee-18211ecf440a",
      "name": "Get sent posts from Buffer",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        920,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "// Hub 2 - mark posts Live once Buffer shows them as sent; alert if one is 15+ minutes late\nconst cfg = $('Config').first().json;\nconst rt = (s) => ({ rich_text: [{ text: { content: String(s).slice(0, 1900) } }] });\nconst txt = (p) => ((p && (p.rich_text || p.title)) || []).map(t => t.plain_text).join('');\nconst runId = 'run-' + $execution.id;\nconst reply = $input.first().json;\nconst posts = reply.data && reply.data.posts;\nif (!posts) throw new Error(\"Buffer did not return the list of sent posts. Detail: \" + JSON.stringify(reply.errors || reply.error || reply).slice(0, 300));\nconst sentIds = new Set((posts.edges || []).map(e => e.node.id));\nconst links = {};\n(posts.edges || []).forEach(e => { links[e.node.id] = e.node.externalLink; });\nconst pages = $('Find due scheduled posts').first().json.results || [];\nconst logBody = (event, d, detail) => ({ parent: { database_id: cfg.logDbId }, properties: {\n  'Run': { title: [{ text: { content: runId + ' ' + event } }] }, 'System': rt('Publishing Hub'), 'Item': rt(d.title),\n  'Event': { select: { name: event } }, 'Detail': rt(detail), 'Model': rt('none (no AI step)'), 'Cost': { number: 0 }, 'Approver': rt(d.approver || '') } });\nconst A = [];\nfor (const page of pages) {\n  const pr = page.properties || {};\n  const platforms = ((pr['Platforms'] || {}).multi_select || []).map(o => o.name);\n  const map = {};\n  txt(pr['Publisher ID']).split(';').forEach(s => { const [k, v] = s.split('='); if (k && v) map[k.trim()] = v.trim(); });\n  let at = ((pr['Publish at'] || {}).date || {}).start || '';\n  if (at && !/(Z|[+-]\\d\\d:\\d\\d)$/.test(at)) at += (cfg.timezoneOffset || '+05:30');\n  const d = { title: txt(pr['Title']) || '(untitled)', approver: ((pr['Approved by'] || {}).people || []).map(a => a.name || '').join(', ') };\n  const allSent = platforms.length > 0 && platforms.every(p => map[p] && sentIds.has(map[p]));\n  const lateMin = (Date.now() - new Date(at).getTime()) / 60000;\n  if (allSent) {\n    const urls = platforms.map(p => links[map[p]]).filter(Boolean);\n    const props = { 'Status': { select: { name: 'Live' } }, 'Last error': { rich_text: [] } };\n    if (urls.length) props['Post URL'] = { url: urls[0] };\n    A.push({ json: { type: 'notion', pageId: page.id, body: { properties: props } } });\n    A.push({ json: { type: 'log', body: logBody('published', d, 'Buffer shows it as sent on ' + platforms.join(' + ') + (urls.length ? '. Links: ' + urls.join(' , ') : '')) } });\n  } else if (lateMin > 15) {\n    const text = 'It was due ' + Math.round(lateMin) + ' minutes ago but Buffer does not show it as sent. Check the channel in Buffer (it may be disconnected), then re-approve.';\n    A.push({ json: { type: 'notion', pageId: page.id, body: { properties: { 'Status': { select: { name: 'Failed' } }, 'Last error': rt(text) } } } });\n    A.push({ json: { type: 'slack', webhook: cfg.slackWebhook, text: ':rotating_light: *' + d.title + '* may not have gone out. ' + text + '\\n<' + page.url + '|Open in Notion>' } });\n    A.push({ json: { type: 'log', body: logBody('failed', d, text) } });\n  }\n}\nreturn A;\n"
      },
